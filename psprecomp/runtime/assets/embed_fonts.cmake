# Generates a C++ source embedding the savedata-dialog fonts (OFL, see
# assets/fonts/OFL-*.txt) so the runtime needs no data files at run time.
#   cmake -DFONT_DIR=<assets/fonts> -DOUT=<out.cpp> -P embed_fonts.cmake
set(_out "// Generated by assets/embed_fonts.cmake - do not edit.\n")
foreach(_pair "psp_ui_font_cinzel|Cinzel.ttf" "psp_ui_font_body|CrimsonText-Regular.ttf"
              "psp_ui_font_bodyb|CrimsonText-SemiBold.ttf")
    string(REPLACE "|" ";" _p "${_pair}")
    list(GET _p 0 _name)
    list(GET _p 1 _file)
    file(READ "${FONT_DIR}/${_file}" _hex HEX)
    string(LENGTH "${_hex}" _hl)
    math(EXPR _len "${_hl} / 2")
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," _arr "${_hex}")
    string(APPEND _out "extern const unsigned char ${_name}[];\nconst unsigned char ${_name}[] = {${_arr}};\n"
        "extern const unsigned long ${_name}_len;\nconst unsigned long ${_name}_len = ${_len}UL;\n")
endforeach()
file(WRITE "${OUT}" "${_out}")
